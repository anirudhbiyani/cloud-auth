# OpenTofu working files. State here is disposable and may contain cluster
# CA data / API tokens -- never commit it.
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.backup
crash.log
crash.*.log

# tfvars are generated by the driver from the other clouds' stage-1 facts.
*.tfvars
*.tfvars.json
!example.tfvars
!*.example.tfvars
